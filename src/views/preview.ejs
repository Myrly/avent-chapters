<%- include("layout", { title, titleKey, body: `
<section class="brutal-card">
  <p class="eyebrow" data-i18n="preview.eyebrow">Aperçu du découpage</p>
  <h1 data-i18n="preview.title">Votre plan de lecture</h1>
  <p data-i18n="preview.description">Vérifiez les pages prévues pour chaque jour.</p>
  <p class="status-error" data-preview-error role="alert" hidden></p>
  <div data-preview-results hidden>
    <p class="status-message" data-preview-summary></p>
    <p class="status-message" data-preview-note hidden></p>
    <p class="status-message" data-preview-duplicates hidden></p>
    <section class="plan-statistics" data-preview-statistics hidden aria-labelledby="preview-statistics-title">
      <h2 id="preview-statistics-title" data-i18n="preview.stats.title">Reading plan statistics</h2>
      <dl class="plan-statistics-grid">
        <div><dt data-i18n="preview.stats.average">Average pages per day</dt><dd><span data-preview-stat="average"></span></dd></div>
        <div><dt data-i18n="preview.stats.median">Median pages per day</dt><dd><span data-preview-stat="median"></span></dd></div>
        <div><dt data-i18n="preview.stats.maximum">Maximum pages per day</dt><dd><span data-preview-stat="maximum"></span></dd></div>
        <div><dt data-i18n="preview.stats.minimum">Minimum pages per day</dt><dd><span data-preview-stat="minimum"></span></dd></div>
      </dl>
    </section>
    <p class="status-message" data-preview-statistics-unavailable data-i18n="preview.stats.unavailable" hidden></p>
    <ol class="division-list" data-preview-days></ol>
  </div>
  <div class="action-row">
    <a class="button" href="/manual.html" data-preview-back data-i18n="preview.back">Modifier les données</a>
    <a class="button button-secondary" href="/index.html" data-i18n="common.home">Retour à l'accueil</a>
  </div>
</section>
<script type="module" src="/scripts/preview.js"></script>
` }) %>
